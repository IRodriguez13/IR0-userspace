+	/*
+	 * Prefer stdin when the caller already wired a non-tty fd0 (smokes,
+	 * scripts). Otherwise /dev/tty would steal input from the console and
+	 * ignore the password pipe. Interactive login still uses a real tty.
+	 */
+	if (!isatty(STDIN_FILENO))
+		response = readpassphrase(challenge, rbuf, sizeof(rbuf), RPP_STDIN);
+	else
+	{
+		response = readpassphrase(challenge, rbuf, sizeof(rbuf),
+					  RPP_REQUIRE_TTY);
+		if (response == NULL && errno == ENOTTY)
+			response = readpassphrase(challenge, rbuf, sizeof(rbuf),
+						  RPP_STDIN);
+	}
+	if (response == NULL && errno == ENOTTY)
+	{
 		syslog(LOG_AUTHPRIV | LOG_NOTICE,
-			"tty required for %s", myname);

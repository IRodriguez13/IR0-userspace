@@ -36,6 +36,48 @@
 #include "openbsd.h"
 #include "doas.h"
 
+#include <fcntl.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+
+/*
+ * IR0 kernel TCGETS is Linux uapi termios (NCCS=19 → 36 bytes). musl's
+ * struct termios is larger; libc tcsetattr corrupts ICRNL/ICANON and
+ * doas password prompts hang on Enter. Drive echo via the raw ioctl.
+ */
+#define IR0_TCGETS 0x5401u
+#define IR0_TCSETS 0x5402u
+#define IR0_IFLAG_ICRNL  0x00000100u
+#define IR0_LFLAG_ISIG   0x00000001u
+#define IR0_LFLAG_ICANON 0x00000002u
+#define IR0_LFLAG_ECHO   0x00000008u
+#define IR0_LFLAG_ECHOE  0x00000010u
+#define IR0_LFLAG_ECHOK  0x00000020u
+#define IR0_LFLAG_ECHONL 0x00000040u
+
+struct ir0_ktios {
+	unsigned int c_iflag;
+	unsigned int c_oflag;
+	unsigned int c_cflag;
+	unsigned int c_lflag;
+	unsigned char c_line;
+	unsigned char c_cc[19];
+};
+
+static void
+ir0_tty_set_echo(int enable)
+{
+	struct ir0_ktios t;
+
+	memset(&t, 0, sizeof(t));
+	if (syscall(SYS_ioctl, STDIN_FILENO, IR0_TCGETS, &t) != 0)
+		return;
+	t.c_iflag |= IR0_IFLAG_ICRNL;
+	t.c_lflag |= (IR0_LFLAG_ISIG | IR0_LFLAG_ICANON | IR0_LFLAG_ECHONL);
+	if (enable)
+		t.c_lflag |= (IR0_LFLAG_ECHO | IR0_LFLAG_ECHOE | IR0_LFLAG_ECHOK);
+	else
+		t.c_lflag &= ~(IR0_LFLAG_ECHO | IR0_LFLAG_ECHOE | IR0_LFLAG_ECHOK);
+	(void)syscall(SYS_ioctl, STDIN_FILENO, IR0_TCSETS, &t);
+}
+

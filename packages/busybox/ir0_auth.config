# IR0 privileged BusyBox (installed set-user-ID root, mode 4755).
#
# Only the applets that legitimately need UID 0 live here, so the setuid
# boundary stays as small as possible (upstream BusyBox recommends a second,
# reduced binary for this instead of making the big multi-call ELF setuid):
#
#   login  — authenticates and starts a session (spawned by getty as root)
#   su     — switches to another account after authenticating
#
# passwd is NOT here: IR0 ships a dedicated set-user-ID ELF
# (setup/runit/ir0_passwd.c) that shares the account library with the console
# login, so shadow(5) has a single writer.

CONFIG_BUSYBOX=y
CONFIG_STATIC=y

# Applet dispatch must drop privileges for anything that is not marked as
# needing them (BB_SUID_DROP semantics).
CONFIG_FEATURE_SUID=y
CONFIG_FEATURE_SUID_CONFIG=n
CONFIG_FEATURE_PREFER_APPLETS=n
CONFIG_FEATURE_SH_STANDALONE=n

# Accounts come from the flat files, with shadow(5) hashes.
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_FEATURE_SHADOWPASSWDS=y
# SHA-512 crypt ($6$) support for verifying the hashes written by ir0_passwd.
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y

# Privileged applets
CONFIG_LOGIN=y
CONFIG_FEATURE_NOLOGIN=y
CONFIG_FEATURE_SECURETTY=y
CONFIG_SU=y
CONFIG_FEATURE_SU_SYSLOG=n
CONFIG_FEATURE_SU_CHECKS_SHELLS=y

# Everything else stays out of the setuid binary.
CONFIG_ASH=n
CONFIG_HUSH=n
# The shell choice must be NONE too, otherwise BusyBox still exports an "sh"
# applet alias inside the setuid binary.
CONFIG_SH_IS_ASH=n
CONFIG_SH_IS_HUSH=n
CONFIG_SH_IS_NONE=y
CONFIG_BASH_IS_NONE=y
CONFIG_PASSWD=n
CONFIG_SULOGIN=n
CONFIG_GETTY=n
CONFIG_ADDUSER=n
CONFIG_ADDGROUP=n
CONFIG_DELUSER=n
CONFIG_DELGROUP=n
CONFIG_CAT=n
CONFIG_LS=n
CONFIG_INIT=n
CONFIG_MOUNT=n
CONFIG_VI=n
CONFIG_NC=n
CONFIG_TELNETD=n
CONFIG_HTTPD=n
CONFIG_IFCONFIG=n
CONFIG_PING=n
CONFIG_UDHCPC=n
CONFIG_WGET=n

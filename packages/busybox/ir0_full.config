# IR0 general-purpose BusyBox (never set-user-ID).
#
# Installed as /bin/busybox mode 0755 root:root. Privileged applets (login, su)
# live in a separate reduced binary (ir0_auth.config) so the multi-call
# dispatcher of this large build never sits on the setuid boundary.
#
# Scope: coreutils + the util-linux subset that has a syscall path in IR0.
# Still OFF: networking, init/runit replacements, job control.
# Line editing + tab completion ON for product ash (needs non-canonical TTY).
#
# The Development profile ships every applet here to expose gaps; the applet
# matrix (make busybox-matrix) is what decides supported/partial/unavailable,
# never "it compiled".

CONFIG_BUSYBOX=y
CONFIG_STATIC=y

# Core shell
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_SH_IS_NONE=n
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_JOB_CONTROL=n
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_HISTORY=255
# Prompt expansion: needed for PS1='user@host:$PWD$ ' in /etc/profile.
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y

# Accounts are read from /etc/passwd, /etc/group and /etc/shadow — no NSS.
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
# This binary is not setuid: never let an applet assume it can raise privilege.
CONFIG_FEATURE_SUID=n

# Coreutils — file / directory
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_PWD=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_TOUCH=y
CONFIG_LN=y
CONFIG_LINK=y
CONFIG_UNLINK=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_STAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CHGRP=y
CONFIG_MKTEMP=y
CONFIG_MKNOD=y
CONFIG_MKFIFO=y
CONFIG_DD=y
CONFIG_DU=y
CONFIG_DF=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y

# Coreutils — text / filters
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_TEE=y
CONFIG_TAC=y
CONFIG_NL=y
CONFIG_PASTE=y
CONFIG_COMM=y
CONFIG_CMP=y
CONFIG_SPLIT=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_XARGS=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_CKSUM=y
CONFIG_BASE64=y

# Coreutils — misc
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_UNAME=y
CONFIG_CLEAR=y
CONFIG_SLEEP=y
CONFIG_USLEEP=y
CONFIG_PRINTF=y
CONFIG_ENV=y
CONFIG_PRINTENV=y
CONFIG_EXPR=y
CONFIG_SEQ=y
CONFIG_YES=y
CONFIG_DATE=y
CONFIG_ID=y
CONFIG_WHOAMI=y
CONFIG_GROUPS=y
CONFIG_LOGNAME=y
CONFIG_NPROC=y
CONFIG_HOSTNAME=y
CONFIG_UPTIME=y
CONFIG_FREE=y
CONFIG_TTY=y

# Inspection
CONFIG_FIND=y
CONFIG_WHICH=y
CONFIG_DMESG=y
CONFIG_LESS=y
CONFIG_MORE=y
CONFIG_MAN=y

# Archives (local only, no network fetch)
CONFIG_TAR=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y

# Processes
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_PIDOF=y
CONFIG_NICE=y
CONFIG_TIME=y

# Terminal
CONFIG_STTY=y
CONFIG_RESET=y

# Mounts (recovery remount path: mount -o remount,rw /)
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_UMOUNT=y
CONFIG_MOUNTPOINT=y
CONFIG_CHROOT=y
CONFIG_SWITCH_ROOT=n

# Power / sync (product rootfs + runit)
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_SYNC=y

# Privileged applets live in the reduced auth binary, not here.
CONFIG_LOGIN=n
CONFIG_SU=n
CONFIG_PASSWD=n
CONFIG_SULOGIN=n
CONFIG_GETTY=n
CONFIG_ADDUSER=n
CONFIG_ADDGROUP=n
CONFIG_DELUSER=n
CONFIG_DELGROUP=n

# Keep off: no networking, no init replacement, no editor yet.
CONFIG_VI=n
CONFIG_NC=n
CONFIG_TELNETD=n
CONFIG_HTTPD=n
CONFIG_IFCONFIG=n
CONFIG_PING=n
CONFIG_ROUTE=n
CONFIG_UDHCPC=n
CONFIG_WGET=n
CONFIG_INIT=n
CONFIG_RUNSV=n
CONFIG_SV=n
